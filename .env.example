# AlphaForge API / worker configuration.
# Copy to .env and fill in. The values below are the Supabase CLI local-dev
# defaults (public, NOT secret). Confirm them with `supabase status`, and ALWAYS
# replace them for any non-local deployment.

# --- Supabase -------------------------------------------------------------
# API endpoint (NOT the Studio dashboard, which is on 54323 locally).
SUPABASE_URL=http://127.0.0.1:54321

# From `supabase status` (anon + service_role keys, and the JWT secret).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9

# --- Redis / arq ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- Storage buckets (created by the MarketDNA_DB migration) --------------
REPORTS_BUCKET=reports
UNIVERSES_BUCKET=universes
SIGNED_URL_TTL=3600
